---
import "../styles/genel.css";
import "../styles/gezinti.css";
import { çeviriAl, type Dil } from "../i18n/çeviriAraçları";
import { diğerDilYolu } from "../i18n/adresHaritası";
import TemaBaşlatıcı from "../components/TemaBaşlatıcı.astro";
import YükleniyorAnimasyon from "../components/YükleniyorAnimasyon.astro";
import Gezinti from "../components/Gezinti.astro";
import AltBilgi from "../components/AltBilgi.astro";
import HenüzHazırDeğilPopup from "../components/HenüzHazırDeğilPopup.astro";

interface Props {
  başlık: string;
  dil: Dil;
  açıklama?: string;
  ogGörsel?: string;
}

const { başlık, dil, açıklama, ogGörsel } = Astro.props;
const ogGörselUrl = new URL(
  ogGörsel ?? "/assets/og-varsayılan.png",
  Astro.site,
).toString();
const sayfaUrl = new URL(Astro.url.pathname, Astro.site).toString();
const ogBaşlık =
  başlık === "Ana Sayfa" || başlık === "Home"
    ? `Marco La'datema — Geliştirici, Yapıcı, Oyuncu`
    : `${başlık} — Marco La'datema`;
const t = çeviriAl(dil);

// Diller arası eşleşme adres haritasından gelir; bölüm slug'ları dile göre
// ayrıştığı için dil önekini değiştirmek yeterli değildir.
const sayfaYolu = decodeURIComponent(Astro.url.pathname);

// Derleme çıktısı dizin biçiminde olduğu için canonical adres eğik çizgiyle
// biter; hreflang adreslerinin ona birebir eşleşmesi gerekir.
function dizinBiçimine(yol: string): string {
  return yol.endsWith("/") ? yol : `${yol}/`;
}

const türkçeYol = dizinBiçimine(
  dil === "tr" ? sayfaYolu : await diğerDilYolu(sayfaYolu, "tr"),
);
const ingilizceYol = dizinBiçimine(
  dil === "en" ? sayfaYolu : await diğerDilYolu(sayfaYolu, "en"),
);
---

<!doctype html>
<html lang={dil}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{başlık} — Marco La'datema</title>

    <meta name="description" content={açıklama ?? ""} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={sayfaUrl} />
    <meta property="og:title" content={ogBaşlık} />
    <meta property="og:description" content={açıklama ?? ""} />
    <meta property="og:image" content={ogGörselUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={dil === "tr" ? "tr_TR" : "en_US"} />
    <meta property="og:site_name" content="Marco La'datema" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={sayfaUrl} />
    <meta name="twitter:title" content={ogBaşlık} />
    <meta name="twitter:description" content={açıklama ?? ""} />
    <meta name="twitter:image" content={ogGörselUrl} />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="canonical" href={sayfaUrl} />
    <link
      rel="alternate"
      hreflang="tr"
      href={new URL(türkçeYol, Astro.site).toString()}
    />
    <link
      rel="alternate"
      hreflang="en"
      href={new URL(ingilizceYol, Astro.site).toString()}
    />

    <TemaBaşlatıcı />

  </head>
  <body>
    <YükleniyorAnimasyon />
    <Gezinti dil={dil} t={t} />
    <main>
      <slot />
    </main>
    <AltBilgi dil={dil} t={t} />
    <HenüzHazırDeğilPopup dil={dil} />
  </body>
</html>
