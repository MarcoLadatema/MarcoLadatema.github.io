---
import type { Dil } from "../i18n/çeviriAraçları";
import type { çeviriAl } from "../i18n/çeviriAraçları";
import { bölümYolu, diğerDilYolu } from "../i18n/adresHaritası";
// Ana sitenin rehbere tek yönlü bağlantısı; ayırma anında bu satır silinir.
import { rehberBağlantısı } from "../BG3/anaSiteBağlantısı";

interface Props {
  dil: Dil;
  t: ReturnType<typeof çeviriAl>;
  /** Düzenden gelir; verilmezse adres haritasından hesaplanır (karar 20). */
  diğerDilAdresi?: string;
}

const { dil, t, diğerDilAdresi } = Astro.props;
const sayfaYolu = decodeURIComponent(Astro.url.pathname);
const normalleştirilmişYol =
  sayfaYolu.endsWith("/") && sayfaYolu !== `/${dil}/`
    ? sayfaYolu.slice(0, -1)
    : sayfaYolu;

const bağlantılar = [
  { ad: t.gezinti.anaSayfa, yol: `/${dil}/` },
  { ad: t.gezinti.projeler, yol: bölümYolu(dil, "projeler") },
  { ad: t.gezinti.başarılar, yol: bölümYolu(dil, "başarılar") },
  { ad: t.gezinti.blog, yol: bölümYolu(dil, "blog") },
  { ad: t.gezinti.sosyalMedya, yol: bölümYolu(dil, "sosyalMedya") },
  rehberBağlantısı(dil),
  { ad: t.gezinti.iletişim, yol: bölümYolu(dil, "iletişim") },
];

const diğerDil = dil === "tr" ? "en" : "tr";
const mevcutYol =
  diğerDilAdresi ?? (await diğerDilYolu(sayfaYolu, diğerDil));
---

<nav class="gezinti">
  <a href={`/${dil}/`} class="gezinti-logo">
    <img src="/assets/logo.png" alt="Marco La'datema Logo" />
    <span>Marco La'datema</span>
  </a>

  <ul class="gezinti-menü">
    {
      bağlantılar.map((bağlantı) => (
        <li>
          <a
            href={bağlantı.yol}
            class={normalleştirilmişYol === bağlantı.yol ? "aktif" : ""}
          >
            {bağlantı.ad}
          </a>
        </li>
      ))
    }
  </ul>

  <div class="gezinti-sağ">
    <button class="hamburger" aria-label="Menüyü aç" aria-expanded="false">
      <i class="ti ti-menu-2" aria-hidden="true"></i>
    </button>
    <button class="ayarlar-butonu" id="ayarlar-butonu" aria-label="Ayarlar">
      <i class="ti ti-settings" aria-hidden="true"></i>
    </button>
  </div>
</nav>

<div class="ayarlar-paneli" id="ayarlar-paneli" aria-hidden="true">
  <div class="ayarlar-bölüm">
    <div class="ayarlar-etiket">{t.ayarlar.tema}</div>
    <div class="tema-toggle" id="tema-toggle">
      <button class="tema-seçenek" data-tema="açık" aria-label="Açık tema">
        <i class="ti ti-sun" aria-hidden="true"></i>
        <span>{t.ayarlar.açık}</span>
      </button>

      <button
        class="tema-seçenek"
        data-tema="otomatik"
        aria-label="Otomatik tema"
      >
        <i class="ti ti-settings-automation" aria-hidden="true"></i>
        <span>{t.ayarlar.otomatik}</span>
      </button>

      <button class="tema-seçenek" data-tema="koyu" aria-label="Koyu tema">
        <i class="ti ti-moon" aria-hidden="true"></i>
        <span>{t.ayarlar.koyu}</span>
      </button>
    </div>
  </div>

  <div class="ayarlar-ayraç"></div>

  <div class="ayarlar-bölüm">
    <div class="ayarlar-etiket">{t.ayarlar.dil}</div>
    <div class="dil-toggle">
      <a
        href={dil === "en" ? mevcutYol : Astro.url.pathname}
        class={`dil-seçenek${dil === "tr" ? " aktif" : ""}`}>TR</a
      >
      <a
        href={dil === "tr" ? mevcutYol : Astro.url.pathname}
        class={`dil-seçenek${dil === "en" ? " aktif" : ""}`}>EN</a
      >
    </div>
  </div>

  <div class="ayarlar-ayraç"></div>

  <div class="ayarlar-bölüm">
    <div class="ayarlar-etiket">{t.ayarlar.boyut}</div>
    <div class="boyut-toggle" id="boyut-toggle">
      <button class="boyut-seçenek" data-boyut="0.85" aria-label="Küçük boyut">
        <span class="boyut-harf">A</span>
        <span>{t.ayarlar.küçük}</span>
      </button>
      <button class="boyut-seçenek" data-boyut="1" aria-label="Normal boyut">
        <span class="boyut-harf">A</span>
        <span>{t.ayarlar.normal}</span>
      </button>
      <button class="boyut-seçenek" data-boyut="1.15" aria-label="Büyük boyut">
        <span class="boyut-harf">A</span>
        <span>{t.ayarlar.büyük}</span>
      </button>
    </div>
  </div>
</div>

<div class="mobil-menü" aria-hidden="true">
  <ul class="mobil-menü-liste">
    {
      bağlantılar.map((bağlantı) => (
        <li>
          <a
            href={bağlantı.yol}
            class={normalleştirilmişYol === bağlantı.yol ? "aktif" : ""}
          >
            {bağlantı.ad}
          </a>
        </li>
      ))
    }
  </ul>
</div>

<script>
  const hamburger = document.querySelector<HTMLButtonElement>(".hamburger");
  const mobilMenü = document.querySelector<HTMLElement>(".mobil-menü");

  function hamburgerİkonunuGüncelle(açıkMı: boolean) {
    const ikon = hamburger?.querySelector("i");
    if (ikon) ikon.className = açıkMı ? "ti ti-x" : "ti ti-menu-2";
  }

  function mobilMenüyüAyarla(açıkMı: boolean) {
    mobilMenü?.classList.toggle("açık", açıkMı);
    mobilMenü?.setAttribute("aria-hidden", (!açıkMı).toString());
    hamburger?.setAttribute("aria-expanded", açıkMı.toString());
    hamburgerİkonunuGüncelle(açıkMı);
  }

  function mobilMenüyüKapat() {
    mobilMenüyüAyarla(false);
  }

  if (hamburger && mobilMenü) {
    hamburger.addEventListener("click", () => {
      mobilMenüyüAyarla(!mobilMenü.classList.contains("açık"));
    });

    // Menünün ve hamburgerin dışına tıklamak menüyü kapatır; ayarlar
    // panelindeki davranışın aynısıdır.
    document.addEventListener("click", (olay) => {
      if (
        !mobilMenü.contains(olay.target as Node) &&
        !hamburger.contains(olay.target as Node)
      ) {
        mobilMenüyüKapat();
      }
    });
  }

  document.querySelectorAll(".mobil-menü-liste a").forEach((bağlantı) => {
    bağlantı.addEventListener("click", mobilMenüyüKapat);
  });

  const ayarlarButonu = document.getElementById("ayarlar-butonu");
  const ayarlarPaneli = document.getElementById("ayarlar-paneli");

  if (ayarlarButonu && ayarlarPaneli) {
    // Tıklama BİLEREK durdurulmaz: aşağıdaki `contains` kontrolü panelin
    // kendi kendini kapatmasını zaten engelliyor, olayın belgeye ulaşması ise
    // açık mobil menünün kapanmasını sağlıyor. İki menü aynı anda açılmaz.
    ayarlarButonu.addEventListener("click", () => {
      const açıkMı = ayarlarPaneli.classList.toggle("açık");
      ayarlarPaneli.setAttribute("aria-hidden", (!açıkMı).toString());
    });

    document.addEventListener("click", (olay) => {
      if (
        !ayarlarPaneli.contains(olay.target as Node) &&
        !ayarlarButonu.contains(olay.target as Node)
      ) {
        ayarlarPaneli.classList.remove("açık");
        ayarlarPaneli.setAttribute("aria-hidden", "true");
      }
    });
  }

  type TemaSeçimi = "açık" | "otomatik" | "koyu";

  function sistemTemasıKoyu(): boolean {
    return window.matchMedia("(prefers-color-scheme: dark)").matches;
  }

  function temayıUygula(seçim: TemaSeçimi) {
    const köklü = document.documentElement;
    if (seçim === "koyu" || (seçim === "otomatik" && sistemTemasıKoyu())) {
      köklü.setAttribute("data-tema", "koyu");
    } else {
      köklü.setAttribute("data-tema", "açık");
    }
  }

  function aktifSeçeneğiGüncelle(seçim: TemaSeçimi) {
    document.querySelectorAll(".tema-seçenek").forEach((btn) => {
      btn.classList.toggle(
        "aktif",
        (btn as HTMLElement).dataset.tema === seçim,
      );
    });
  }

  const kayıtlıTema =
    (localStorage.getItem("tema") as TemaSeçimi) ?? "otomatik";
  temayıUygula(kayıtlıTema);
  aktifSeçeneğiGüncelle(kayıtlıTema);

  document.querySelectorAll(".tema-seçenek").forEach((btn) => {
    btn.addEventListener("click", () => {
      const seçim = (btn as HTMLElement).dataset.tema as TemaSeçimi;
      localStorage.setItem("tema", seçim);
      temayıUygula(seçim);
      aktifSeçeneğiGüncelle(seçim);
    });
  });

  window
    .matchMedia("(prefers-color-scheme: dark)")
    .addEventListener("change", () => {
      const mevcutSeçim =
        (localStorage.getItem("tema") as TemaSeçimi) ?? "otomatik";
      if (mevcutSeçim === "otomatik") {
        temayıUygula("otomatik");
      }
    });

  // Ayarlar paneli sayfa geçişi sonrası
  if (ayarlarPaneli && localStorage.getItem("ayarlar-paneli-açık") === "true") {
    ayarlarPaneli.classList.add("açık");
    ayarlarPaneli.setAttribute("aria-hidden", "false");
    localStorage.removeItem("ayarlar-paneli-açık");
  }

  document.querySelectorAll(".dil-seçenek").forEach((link) => {
    link.addEventListener("click", () => {
      const seçilenDil = (link as HTMLAnchorElement).href.includes("/en/")
        ? "en"
        : "tr";
      localStorage.setItem("dil", seçilenDil);
      localStorage.setItem("ayarlar-paneli-açık", "true");
    });
  });

  // Kök font-size ölçeklenir; tüm ölçüler rem olduğu için sayfa bütün olarak büyür.
  // style.zoom kullanılmaz — tarayıcılar arası tutarsızdır ve kullanıcının
  // kendi yakınlaştırmasıyla çakışır.
  function yazıBoyutunuUygula(oran: string) {
    document.documentElement.style.fontSize = Number(oran) * 100 + "%";
    // Kırılma noktası seçilen orana göre değişir; CSS oranı buradan okur.
    document.documentElement.dataset.boyut = oran;
  }

  const kayıtlıBoyut = localStorage.getItem("yazıBoyutu") ?? "1";
  yazıBoyutunuUygula(kayıtlıBoyut);

  document.querySelectorAll(".boyut-seçenek").forEach((düğme) => {
    const düğmeBoyutu = (düğme as HTMLElement).dataset.boyut ?? "1";
    if (düğmeBoyutu === kayıtlıBoyut) düğme.classList.add("aktif");

    düğme.addEventListener("click", () => {
      const seçilenBoyut = (düğme as HTMLElement).dataset.boyut ?? "1";
      localStorage.setItem("yazıBoyutu", seçilenBoyut);
      yazıBoyutunuUygula(seçilenBoyut);
      document
        .querySelectorAll(".boyut-seçenek")
        .forEach((diğer) =>
          diğer.classList.toggle(
            "aktif",
            (diğer as HTMLElement).dataset.boyut === seçilenBoyut,
          ),
        );
    });
  });
</script>
